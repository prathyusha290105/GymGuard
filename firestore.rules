rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }

    // ==========================================
    // Security Helper Functions
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isDemoGym(gymId) {
      return gymId == 'gym-01';
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        (request.auth.token.email == 'morthalaprathyusha@gmail.com' ||
         request.auth.token.email == 'owner@gymguard.demo');
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserGymId() {
      return hasUserDoc() ? getUserData().gymId : '';
    }

    function getUserRole() {
      return hasUserDoc() ? getUserData().role : '';
    }

    function getUserMemberId() {
      return hasUserDoc() && ('memberId' in getUserData()) ? getUserData().memberId : '';
    }

    function isGymOwner(gymId) {
      return isDemoGym(gymId) || isBootstrappedAdmin() || (
        isSignedIn() && hasUserDoc() && getUserGymId() == gymId &&
        (getUserRole() == 'GYM_OWNER' || getUserRole() == 'SUPER_ADMIN')
      );
    }

    function isGymStaffOrOwner(gymId) {
      return isDemoGym(gymId) || isBootstrappedAdmin() || (
        isSignedIn() && hasUserDoc() && getUserGymId() == gymId &&
        (getUserRole() == 'GYM_OWNER' || getUserRole() == 'STAFF' || getUserRole() == 'SUPER_ADMIN')
      );
    }

    function isMemberSelf(memberId) {
      return isSignedIn() && (
        request.auth.uid == memberId ||
        (hasUserDoc() && getUserMemberId() == memberId)
      );
    }

    // ==========================================
    // Collections
    // ==========================================

    // Users: Profiles and roles
    match /users/{userId} {
      allow read: if (resource != null && isDemoGym(resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (isSignedIn() && (
          request.auth.uid == userId ||
          (hasUserDoc() && resource.data.gymId == getUserGymId() && isGymStaffOrOwner(resource.data.gymId))
        ));

      // Self-registration allowed, but cannot self-grant GYM_OWNER or SUPER_ADMIN unless bootstrapped admin
      allow create: if isBootstrappedAdmin() || (
        isSignedIn() && request.auth.uid == userId && (
          request.resource.data.role == 'MEMBER' ||
          request.resource.data.role == 'STAFF' ||
          isDemoGym(request.resource.data.gymId)
        )
      ) || (request.resource != null && isDemoGym(request.resource.data.gymId));

      // Role Elevation Prevention: Users cannot change their own role or gymId without being Owner/Admin
      allow update: if isBootstrappedAdmin() || (
        resource != null && isGymOwner(resource.data.gymId)
      ) || (
        isSignedIn() && request.auth.uid == userId && resource != null &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.gymId == resource.data.gymId
      ) || (resource != null && isDemoGym(resource.data.gymId));

      allow delete: if isBootstrappedAdmin() || (resource != null && isGymOwner(resource.data.gymId));
    }

    // Gyms
    match /gyms/{gymId} {
      allow read: if true;
      allow create, update, delete: if isDemoGym(gymId) || isBootstrappedAdmin() || isGymOwner(gymId);
    }

    // Members: Sensitive member records
    match /members/{memberId} {
      allow read: if (resource != null && isDemoGym(resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (resource != null && isGymStaffOrOwner(resource.data.gymId)) ||
        isMemberSelf(memberId);

      allow create, update: if (request.resource != null && isDemoGym(request.resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (request.resource != null && isGymStaffOrOwner(request.resource.data.gymId));

      allow delete: if (resource != null && isDemoGym(resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (resource != null && isGymOwner(resource.data.gymId));
    }

    // Membership Plans
    match /membershipPlans/{planId} {
      allow read: if true;
      allow create, update, delete: if (request.resource != null && isDemoGym(request.resource.data.gymId)) ||
        (resource != null && isDemoGym(resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (request.resource != null && isGymOwner(request.resource.data.gymId)) ||
        (resource != null && isGymOwner(resource.data.gymId));
    }

    // Memberships: Subscriptions
    match /memberships/{membershipId} {
      allow read: if (resource != null && isDemoGym(resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (resource != null && isGymStaffOrOwner(resource.data.gymId)) ||
        (resource != null && isMemberSelf(resource.data.memberId));

      allow create, update: if (request.resource != null && isDemoGym(request.resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (request.resource != null && isGymStaffOrOwner(request.resource.data.gymId));

      allow delete: if (resource != null && isDemoGym(resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (resource != null && isGymOwner(resource.data.gymId));
    }

    // Membership History
    match /membershipHistory/{historyId} {
      allow read: if (resource != null && isDemoGym(resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (resource != null && isGymStaffOrOwner(resource.data.gymId)) ||
        (resource != null && isMemberSelf(resource.data.memberId));

      allow create: if (request.resource != null && isDemoGym(request.resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (request.resource != null && isGymStaffOrOwner(request.resource.data.gymId));

      allow update, delete: if isBootstrappedAdmin() || (resource != null && isGymOwner(resource.data.gymId));
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if (resource != null && isDemoGym(resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (resource != null && isGymStaffOrOwner(resource.data.gymId)) ||
        (resource != null && isMemberSelf(resource.data.memberId));

      allow create, update: if (request.resource != null && isDemoGym(request.resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (request.resource != null && isGymStaffOrOwner(request.resource.data.gymId));

      allow delete: if (resource != null && isDemoGym(resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (resource != null && isGymOwner(resource.data.gymId));
    }

    // Attendance
    match /attendance/{attendanceId} {
      allow read: if (resource != null && isDemoGym(resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (resource != null && isGymStaffOrOwner(resource.data.gymId)) ||
        (resource != null && isMemberSelf(resource.data.memberId));

      allow create, update: if (request.resource != null && isDemoGym(request.resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (request.resource != null && isGymStaffOrOwner(request.resource.data.gymId));

      allow delete: if (resource != null && isDemoGym(resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (resource != null && isGymOwner(resource.data.gymId));
    }

    // Access Logs
    match /accessLogs/{accessLogId} {
      allow read: if (resource != null && isDemoGym(resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (resource != null && isGymStaffOrOwner(resource.data.gymId)) ||
        (resource != null && isMemberSelf(resource.data.memberId));

      allow create, update: if (request.resource != null && isDemoGym(request.resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (request.resource != null && isGymStaffOrOwner(request.resource.data.gymId));

      allow delete: if (resource != null && isDemoGym(resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (resource != null && isGymOwner(resource.data.gymId));
    }

    // Devices: Turnstiles, Controllers (Owner only write)
    match /devices/{deviceId} {
      allow read: if (resource != null && isDemoGym(resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (resource != null && isGymStaffOrOwner(resource.data.gymId));

      allow create, update, delete: if (request.resource != null && isDemoGym(request.resource.data.gymId)) ||
        (resource != null && isDemoGym(resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (request.resource != null && isGymOwner(request.resource.data.gymId)) ||
        (resource != null && isGymOwner(resource.data.gymId));
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if (resource != null && isDemoGym(resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (resource != null && (
          resource.data.recipientId == request.auth.uid ||
          (hasUserDoc() && resource.data.recipientId == getUserMemberId()) ||
          isGymStaffOrOwner(resource.data.gymId)
        ));

      allow create, update: if (request.resource != null && isDemoGym(request.resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        isSignedIn();

      allow delete: if (resource != null && isDemoGym(resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (resource != null && isGymOwner(resource.data.gymId));
    }

    // Audit Logs: Sensitive security audit (Owner only read)
    match /auditLogs/{auditId} {
      allow read: if (resource != null && isDemoGym(resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (resource != null && isGymOwner(resource.data.gymId));

      allow create: if (request.resource != null && isDemoGym(request.resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        isSignedIn();

      allow update, delete: if isBootstrappedAdmin();
    }

    // Settings (Owner only write)
    match /settings/{settingsId} {
      allow read: if (resource != null && isDemoGym(resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (resource != null && isGymStaffOrOwner(resource.data.gymId));

      allow create, update, delete: if (request.resource != null && isDemoGym(request.resource.data.gymId)) ||
        (resource != null && isDemoGym(resource.data.gymId)) ||
        isBootstrappedAdmin() ||
        (request.resource != null && isGymOwner(request.resource.data.gymId)) ||
        (resource != null && isGymOwner(resource.data.gymId));
    }
  }
}
